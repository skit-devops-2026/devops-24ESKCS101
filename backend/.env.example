# Copy this file to a new file named ".env" (same folder) and edit the values.

# Port the backend server will run on
PORT=5001

# MongoDB connection string.
# Local MongoDB (Community Server installed on your laptop):
MONGO_URI=mongodb://127.0.0.1:27017/bookbrew
# MongoDB Atlas (cloud) example - replace user, password and cluster:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bookbrew?retryWrites=true&w=majority

# Any long random text. It is used to sign login tokens (JWT). Keep it secret.
JWT_SECRET=change_this_to_a_long_random_secret_text
